    {
      "parameters": {
        "jsCode": "const ai = $json;\n\nconst candidate = $('New Candidate Data Added (Google Sheets Trigger)').first().json;\nconst job = $('Get Job Description from sheet').first().json;\n\nreturn {\n  json: {\n    job_id: job['Job ID'],\n    timestamp: candidate['Timestamp'],\n\n    candidate_name: ai.candidate_name,\n    email: candidate.Email,\n    phone_number: candidate['Phone Number'],\n    job_applied_for: candidate['Job Applied For'],\n    resume: candidate.Resume,\n\n    match_score: ai.match_score,\n\n    skills_score: ai.score_breakdown.skills_match,\n    experience_score: ai.score_breakdown.experience_match,\n    role_relevance_score: ai.score_breakdown.role_relevance,\n\n    recommendation: ai.recommendation,\n    confidence: ai.confidence,\n\n    experience_match: ai.experience_match,\n    relevant_experience: ai.relevant_experience,\n\n    matching_skills: ai.matching_skills.join(', '),\n    missing_skills: ai.missing_skills.join(', '),\n\n    evidence: ai.evidence.join(' | '),\n    strengths: ai.strengths.join(' | '),\n    concerns: ai.concerns.join(' | ')\n  }\n};"
      },
